{
  "name": "vitalguard-monorepo",
  "version": "1.0.0",
  "description": "VitalGuard AI - Full Stack",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
